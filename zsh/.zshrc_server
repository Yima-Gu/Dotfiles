[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh)"

# Enable Powerlevel10k instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# ----------------------------------------------------------------
# [配置 1] Oh My Zsh 自身更新源
# 以后运行 'omz update' 时会自动走清华镜像，不卡顿
# ----------------------------------------------------------------
export REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/ohmyzsh.git"

# ----------------------------------------------------------------
# [配置 2] 自定义插件路径 (你的数据盘)
# 强制指向 /data/yima，避免占用 /home 空间
# ----------------------------------------------------------------
export ZSH_CUSTOM="/data/yima/zsh_custom"

# Set name of the theme to load
ZSH_THEME="powerlevel10k/powerlevel10k"

# Which plugins would you like to load?
plugins=(
    git
    zsh-autosuggestions
    # zsh-syntax-highlighting # 如果未来安装了这个插件，请取消注释
)

source $ZSH/oh-my-zsh.sh

# User configuration

# ----------------------------------------------------------------
# [配置 3] FZF 模糊搜索 (从数据盘加载)
# ----------------------------------------------------------------
[ -f /data/yima/fzf/.fzf.zsh ] && source /data/yima/fzf/.fzf.zsh

# ----------------------------------------------------------------
# [配置 4] 环境变量检查
# ----------------------------------------------------------------
# 检测结果：HF_ENDPOINT 已经在你之前的检查中显示为 "https://hf-mirror.com"
# 所以这里我们不需要再 export 一次，避免冗余。
# 如果未来发现模型下载变慢，可以取消下面这行的注释：
# export HF_ENDPOINT="https://hf-mirror.com"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/yima/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/yima/anaconda3/etc/profile.d/conda.sh" ]; then
        . "/home/yima/anaconda3/etc/profile.d/conda.sh"
    else
        export PATH="/home/yima/anaconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# ----- My Custom Aliases & Functions -----

alias ls='ls -alhF --color=auto'
alias ll='ls -alhF --color=auto'
alias ..='cd ..'
alias ...='cd ../..'

# 显存监控 (跑实验必备)
alias nv='watch -n 1 nvidia-smi'

# [新功能] GitHub 镜像克隆命令
# 用法: gclone https://github.com/user/repo
# 作用: 自动在前面加上加速镜像，解决你 git config 没配置的问题
function gclone() {
    git clone "https://mirror.ghproxy.com/$1"
}

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ----------------------------------------------------------------
# [历史记录增强配置]
# ----------------------------------------------------------------
# 历史记录文件位置
HISTFILE="$HOME/.zsh_history"
# 保存条数 (设大一点，存个几万条没问题)
HISTSIZE=50000
SAVEHIST=50000

# 敲完一条命令，立刻写入文件 (防止断网丢失)
setopt INC_APPEND_HISTORY

# 开启多窗口共享历史 (窗口A敲的命令，窗口B也能立刻补全)
setopt SHARE_HISTORY

# 记录时间戳
setopt EXTENDED_HISTORY

# 忽略重复命令 (连续敲两次 ls，只记一次)
setopt HIST_IGNORE_DUPS
# 忽略空格开头的命令 (在命令前加空格，就不会被记录，适合输密码)
setopt HIST_IGNORE_SPACE
